<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
  <title>IBKR to Xero</title>
  <options customize="always" require-scripts="false" rootVolumeOnly="true"/>
  <!-- Both components install into system locations (/Applications and
       /usr/local/bin), so only the system domain makes sense. -->
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <license file="LICENSE"/>
  <choices-outline>
    <line choice="gui"/>
    <line choice="cli"/>
  </choices-outline>

  <choice id="gui" title="Desktop GUI"
          description="Install IBKR to Xero.app in Applications."
          start_selected="true" start_enabled="true" start_visible="true">
    <pkg-ref id="com.sergeikulik.ibkr-to-xero.gui"/>
  </choice>
  <choice id="cli" title="Command-line tool"
          description="Install the ibkr2xero command in /usr/local/bin."
          start_selected="true" start_enabled="true" start_visible="true">
    <pkg-ref id="com.sergeikulik.ibkr-to-xero.cli"/>
  </choice>

  <pkg-ref id="com.sergeikulik.ibkr-to-xero.gui">IBKR-to-Xero-GUI.pkg</pkg-ref>
  <pkg-ref id="com.sergeikulik.ibkr-to-xero.cli">IBKR-to-Xero-CLI.pkg</pkg-ref>
</installer-gui-script>
